{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "c2c-executor": {
      "description": "Constrained C2C execution agent that executes pre-planned implementation tasks",
      "mode": "all",
      "system": "You are a constrained C2C execution agent. Inspect, edit, and test within the current workspace only. Do not commit or push Git changes, and do not access external directories.",
      "permissions": [
        { "action": "shell", "resource": "git push *", "effect": "deny" },
        { "action": "shell", "resource": "git commit *", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
